<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0f0f1a">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Başlık -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🛡️ BahisEngel"
            android:textSize="24sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:paddingBottom="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bahis sitesi SMS koruma sistemi"
            android:textSize="13sp"
            android:textColor="#888888"
            android:paddingBottom="16dp"/>

        <!-- Engelleme sayacı -->
        <TextView
            android:id="@+id/tv_blocked_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="0 mesaj engellendi"
            android:textSize="18sp"
            android:textColor="#E74C3C"
            android:textStyle="bold"
            android:background="#1a1a2e"
            android:padding="12dp"
            android:layout_marginBottom="16dp"/>

        <!-- Ayarlar kartı -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1a1a2e"
            android:padding="12dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="AYARLAR"
                android:textSize="11sp"
                android:textColor="#888888"
                android:paddingBottom="8dp"/>

            <!-- Bahis engelle switch -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="10dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🚫 Bahis SMS Engelle"
                    android:textColor="#CCCCCC"
                    android:textSize="14sp"/>
                <Switch
                    android:id="@+id/sw_block_enabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"/>
            </LinearLayout>

            <!-- Bildirim switch -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="10dp">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🔔 Bildirim Gönder"
                    android:textColor="#CCCCCC"
                    android:textSize="14sp"/>
                <Switch
                    android:id="@+id/sw_notify_enabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"/>
            </LinearLayout>

            <!-- Otomatik sil switch -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🗑️ Otomatik Sil"
                    android:textColor="#CCCCCC"
                    android:textSize="14sp"/>
                <Switch
                    android:id="@+id/sw_auto_delete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="false"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Engellenen anahtar kelimeler -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ENGELLENEN ANAHTAR KELİMELER"
            android:textSize="11sp"
            android:textColor="#888888"
            android:paddingBottom="8dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="bahis • casino • bet • slot • rulet • poker • jackpot • bonus • iddaa • bedava spin • kayıt ol • üye ol • para yatır • 1xbet • bets10 • betturkey • betpark • piabet • superbahis • mobilbahis • casinomaxi • jojobet"
            android:textColor="#E74C3C"
            android:textSize="12sp"
            android:background="#1a1a2e"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:lineSpacingMultiplier="1.5"/>

        <!-- Engellenen mesajlar listesi -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ENGELLENMİŞ MESAJLAR"
                android:textSize="11sp"
                android:textColor="#888888"/>

            <Button
                android:id="@+id/btn_clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Temizle"
                android:textSize="11sp"
                android:backgroundTint="#E74C3C"
                android:textColor="#FFFFFF"
                android:padding="4dp"/>
        </LinearLayout>

        <ListView
            android:id="@+id/lv_messages"
            android:layout_width="match_parent"
            android:layout_height="400dp"
            android:background="#1a1a2e"
            android:divider="#333333"
            android:dividerHeight="0.5dp"/>

    </LinearLayout>
</ScrollView>
